# Optional RFQ storage. These variables are separate from Product Intelligence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RFQ_TABLE=rfq_inquiries
SUPABASE_RFQ_BUCKET=rfq-attachments

# Product Intelligence Console V1 shadow database. Local mode accepts loopback URLs only.
# Accepts a modern secret key or legacy service-role key. Never expose it to the browser.
PRODUCT_INTELLIGENCE_SUPABASE_URL=
PRODUCT_INTELLIGENCE_SUPABASE_SERVICE_ROLE_KEY=
PRODUCT_INTELLIGENCE_ENVIRONMENT=local
PRODUCT_INTELLIGENCE_ALLOW_SHADOW_WRITE=false
PRODUCT_INTELLIGENCE_STAGING_PROJECT_REF=

# M2 Console reads use the caller's session, never the shadow-import service key.
# Disabled by default; M2 accepts this loopback UI origin only and rejects Vercel.
CONSOLE_ENABLED=false
CONSOLE_ENVIRONMENT=staging
CONSOLE_ORIGIN=http://127.0.0.1:3000
CONSOLE_SUPABASE_URL=https://fdsvzuqixppsakukkrsf.supabase.co
CONSOLE_SUPABASE_PUBLISHABLE_KEY=

# Operator-only secret for a reviewed hosted staging Auth SMTP update.
# Never set in local Supabase, disposable CI, or the Next.js runtime.
# config.staging.toml is a reference, not a config-push/deployment input.
SUPABASE_AUTH_SMTP_PASS=

# RFQ email delivery and public analytics.
RFQ_EMAIL_RECIPIENT=arcfortweld@outlook.com
RFQ_EMAIL_FROM=
RESEND_API_KEY=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
