{
  "name": "arcfort-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:products": "node scripts/validate-product-csv.mjs docs/product-sku-template.csv",
    "generate:products": "node scripts/generate-products-from-csv.mjs docs/product-sku-template.csv",
    "generate:products:write": "node scripts/generate-products-from-csv.mjs docs/product-sku-template.csv --write",
    "products:validate": "node --experimental-strip-types scripts/validate-products.ts",
    "products:import": "node --experimental-strip-types scripts/import-products.ts",
    "products:check-images": "node --experimental-strip-types scripts/check-product-images.ts",
    "products:image-tasks": "node --experimental-strip-types scripts/generate-product-image-tasks.ts",
    "products:report": "node --experimental-strip-types scripts/report-product-readiness.ts",
    "products:simple:preview": "node --experimental-strip-types scripts/import-simple-products.ts",
    "products:simple:generate": "node --experimental-strip-types scripts/import-simple-products.ts --write",
    "products:simple:import": "node --experimental-strip-types scripts/import-simple-products.ts --write --import",
    "products:refresh-copy": "node --experimental-strip-types scripts/refresh-catalog-product-copy.ts",
    "products:refresh-copy:write": "node --experimental-strip-types scripts/refresh-catalog-product-copy.ts --write",
    "test:rfq": "node --experimental-strip-types scripts/test-rfq-constraints.ts && node --experimental-strip-types scripts/test-rfq-email.ts",
    "test:rfq-email": "node --experimental-strip-types scripts/test-rfq-email.ts",
    "rfq:check-live": "node --experimental-strip-types scripts/check-live-rfq.ts",
    "seo:audit": "node --experimental-strip-types scripts/audit-seo.ts",
    "seo:audit:live": "node --experimental-strip-types scripts/audit-live-seo.ts",
    "security:audit:live": "node --experimental-strip-types scripts/check-live-security-headers.ts",
    "health:production": "node --experimental-strip-types scripts/check-live-rfq.ts && node --experimental-strip-types scripts/audit-live-seo.ts && node --experimental-strip-types scripts/check-live-security-headers.ts",
    "downloads:generate": "node --experimental-strip-types scripts/generate-download-assets.ts",
    "indexing:submit": "node --experimental-strip-types scripts/submit-indexnow.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "botid": "^1.5.11",
    "next": "15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.18",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
